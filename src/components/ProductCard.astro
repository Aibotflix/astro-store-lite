---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { formatPrice } from '../config/store'

export interface Props {
  product: CollectionEntry<'products'>
  class?: string
}

const { product } = Astro.props
const img = product.data.image || '/placeholder.svg'
const payload = JSON.stringify({
  id: product.id, name: product.data.name, price: product.data.price, image: img,
})
---

<article class={`product-card group glass border-border flex h-full flex-col overflow-hidden rounded-2xl border transition-all duration-300 hover:-translate-y-1 hover:shadow-xl ${Astro.props.class || ''}`}>
  <a href={`/product/${product.id}/`} class="aspect-square block overflow-hidden">
    <Image src={img} alt={product.data.name} width={400} height={400} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" decoding="async" />
  </a>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex flex-col gap-1">
      <a href={`/product/${product.id}/`} class="text-text no-underline leading-tight text-lg font-semibold transition-colors hover:opacity-70">{product.data.name}</a>
      {product.data.category && (
        <span class="text-text-muted text-xs font-medium uppercase tracking-wider">{product.data.category}</span>
      )}
    </div>
    <div class="mt-auto flex items-center justify-between gap-4">
      <span class="text-xl font-bold">{formatPrice(product.data.price)}</span>
      <button
        class="add-to-cart bg-accent text-white shrink-0 cursor-pointer rounded-xl px-4 py-2.5 text-sm font-semibold transition-all duration-200 hover:scale-105 active:scale-95"
        data-product={payload}
        aria-label={`Add ${product.data.name} to cart`}
      >
        Add to Cart
      </button>
    </div>
  </div>
</article>

<script>
  import { addToCart } from '../scripts/cart'
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.add-to-cart') as HTMLElement | null
    if (!btn) return
    const item = JSON.parse(btn.dataset.product || '{}')
    addToCart(item, 1)
  })
</script>
