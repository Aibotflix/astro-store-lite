---
export const prerender = true
import StoreLayout from '../layouts/StoreLayout.astro'
---

<StoreLayout title="Payment cancelled">
  <div class="mx-auto max-w-xl px-6 py-24 text-center">
    <h1 class="text-3xl font-bold tracking-tight">Payment cancelled</h1>
    <p class="text-text-muted mt-4">Nothing was charged. Your cart is still waiting.</p>
    <a href="/" class="bg-accent text-white mt-8 inline-flex rounded-xl px-6 py-3 text-sm font-semibold transition-all hover:opacity-80">Back to shop</a>
  </div>
</StoreLayout>
