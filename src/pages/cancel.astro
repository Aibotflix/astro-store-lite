---
export const prerender = true
import StoreLayout from '../layouts/StoreLayout.astro'
---

<StoreLayout title="Payment cancelled">
  <div class="mx-auto max-w-xl px-6 py-24 text-center">
    <h1 class="text-3xl font-bold tracking-tight">Payment cancelled</h1>
    <p class="mt-4" style="color: var(--color-text-muted);">Nothing was charged. Your cart is still waiting.</p>
    <a href="/" class="mt-8 inline-flex rounded-xl px-6 py-3 text-sm font-semibold transition-all hover:opacity-80" style="background: var(--color-accent); color: white;">Back to shop</a>
  </div>
</StoreLayout>
