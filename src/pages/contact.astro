---
export const prerender = true
import StoreLayout from '../layouts/StoreLayout.astro'
import { SITE } from '../config/store'
---

<StoreLayout title="Contact">
  <div class="mx-auto max-w-2xl px-6 py-16 sm:py-24">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Get in touch</h1>
    <p class="text-text-muted mt-2">We'll get back to you within 24 hours.</p>
    
    <div class="border-border bg-surface mt-8 grid gap-4 rounded-2xl border p-6 sm:grid-cols-3">
      <div>
        <div class="text-text-muted text-xs font-semibold uppercase tracking-wider">Address</div>
        <div class="text-text mt-1 text-sm">{SITE.address}</div>
      </div>
      <div>
        <div class="text-text-muted text-xs font-semibold uppercase tracking-wider">Phone</div>
        <div class="text-text mt-1 text-sm">{SITE.phone}</div>
      </div>
      <div>
        <div class="text-text-muted text-xs font-semibold uppercase tracking-wider">Email</div>
        <div class="text-text mt-1 text-sm">{SITE.email}</div>
      </div>
    </div>

    <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="mt-12 flex flex-col gap-6">
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label class="text-text mb-1 block text-sm font-medium">Name</label>
          <input type="text" name="name" required class="border-border bg-surface text-text w-full rounded-xl border px-4 py-3 text-sm outline-none transition-all focus:ring-2" />
        </div>
        <div>
          <label class="text-text mb-1 block text-sm font-medium">Email</label>
          <input type="email" name="email" required class="border-border bg-surface text-text w-full rounded-xl border px-4 py-3 text-sm outline-none transition-all focus:ring-2" />
        </div>
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label class="text-text mb-1 block text-sm font-medium">Phone</label>
          <input type="tel" name="phone" class="border-border bg-surface text-text w-full rounded-xl border px-4 py-3 text-sm outline-none transition-all focus:ring-2" />
        </div>
        <div>
          <label class="text-text mb-1 block text-sm font-medium">Address</label>
          <input type="text" name="address" class="border-border bg-surface text-text w-full rounded-xl border px-4 py-3 text-sm outline-none transition-all focus:ring-2" />
        </div>
      </div>
      <div>
        <label class="text-text mb-1 block text-sm font-medium">Message</label>
        <textarea name="message" rows="5" required class="border-border bg-surface text-text w-full rounded-xl border px-4 py-3 text-sm outline-none transition-all focus:ring-2"></textarea>
      </div>
      <button type="submit" class="bg-accent text-white self-start rounded-xl px-8 py-3 text-sm font-semibold transition-all hover:opacity-80">Send message</button>
    </form>
  </div>
</StoreLayout>
