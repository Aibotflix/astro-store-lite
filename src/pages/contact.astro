---
export const prerender = true
import StoreLayout from '../layouts/StoreLayout.astro'
import { SITE } from '../config/store'
---

<StoreLayout title="Contact">
  <div class="mx-auto max-w-2xl px-6 py-16 sm:py-24">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Get in touch</h1>
    <p class="mt-2" style="color: var(--color-text-muted);">We'll get back to you within 24 hours.</p>
    
    <div class="mt-8 grid gap-4 sm:grid-cols-3 rounded-2xl border p-6" style="border-color: var(--color-border); background: var(--color-surface);">
      <div>
        <div class="text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-muted);">Address</div>
        <div class="mt-1 text-sm" style="color: var(--color-text);">{SITE.address}</div>
      </div>
      <div>
        <div class="text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-muted);">Phone</div>
        <div class="mt-1 text-sm" style="color: var(--color-text);">{SITE.phone}</div>
      </div>
      <div>
        <div class="text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-muted);">Email</div>
        <div class="mt-1 text-sm" style="color: var(--color-text);">{SITE.email}</div>
      </div>
    </div>

    <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="mt-12 flex flex-col gap-6">
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label class="mb-1 block text-sm font-medium" style="color: var(--color-text);">Name</label>
          <input type="text" name="name" required class="w-full rounded-xl border px-4 py-3 text-sm outline-none transition-all focus:ring-2" style="border-color: var(--color-border); background: var(--color-surface); color: var(--color-text);" />
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium" style="color: var(--color-text);">Email</label>
          <input type="email" name="email" required class="w-full rounded-xl border px-4 py-3 text-sm outline-none transition-all focus:ring-2" style="border-color: var(--color-border); background: var(--color-surface); color: var(--color-text);" />
        </div>
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label class="mb-1 block text-sm font-medium" style="color: var(--color-text);">Phone</label>
          <input type="tel" name="phone" class="w-full rounded-xl border px-4 py-3 text-sm outline-none transition-all focus:ring-2" style="border-color: var(--color-border); background: var(--color-surface); color: var(--color-text);" />
        </div>
        <div>
          <label class="mb-1 block text-sm font-medium" style="color: var(--color-text);">Address</label>
          <input type="text" name="address" class="w-full rounded-xl border px-4 py-3 text-sm outline-none transition-all focus:ring-2" style="border-color: var(--color-border); background: var(--color-surface); color: var(--color-text);" />
        </div>
      </div>
      <div>
        <label class="mb-1 block text-sm font-medium" style="color: var(--color-text);">Message</label>
        <textarea name="message" rows="5" required class="w-full rounded-xl border px-4 py-3 text-sm outline-none transition-all focus:ring-2" style="border-color: var(--color-border); background: var(--color-surface); color: var(--color-text);"></textarea>
      </div>
      <button type="submit" class="self-start rounded-xl px-8 py-3 text-sm font-semibold transition-all hover:opacity-80" style="background: var(--color-accent); color: white;">Send message</button>
    </form>
  </div>
</StoreLayout>