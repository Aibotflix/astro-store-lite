---
export const prerender = true
import { getCollection } from 'astro:content'
import { SITE } from '../config/store'
import StoreLayout from '../layouts/StoreLayout.astro'
import ProductCard from '../components/ProductCard.astro'
import Hero from '../components/Hero.astro'

const products = await getCollection('products')
---

<StoreLayout title="Home" description={SITE.description}>
  <Hero />
    <section id="products" class="mx-auto max-w-7xl px-6 pb-24">
    <div class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">Featured Collection</h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {products.map(p => (
        <ProductCard product={p} />
      ))}
    </div>
  </section>
</StoreLayout>