---
export const prerender = false
import StoreLayout from '../layouts/StoreLayout.astro'
import Stripe from 'stripe'

const session_id = Astro.url.searchParams.get('session_id')

let purchased: { name: string; productId: string }[] = []

if (session_id) {
  try {
    const stripe = new Stripe(import.meta.env.STRIPE_SECRET_KEY!)
    const session = await stripe.checkout.sessions.retrieve(session_id, {
      expand: ['line_items.data.price.product'],
    })
    if (session.payment_status !== 'paid') throw new Error('not paid')
    for (const li of session.line_items?.data || []) {
      const product = (li.price as any)?.product
      const productId = product?.metadata?.product_id || ''
      purchased.push({ name: li.description || '', productId })
    }
  } catch {}
}
---

<StoreLayout title="Order confirmed">
  <div class="mx-auto max-w-xl px-6 py-24 text-center">
    <div class="bg-accent text-white mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full text-2xl">✓</div>
    <h1 class="text-3xl font-bold tracking-tight">Order confirmed!</h1>
    <p class="text-text-muted mt-4">Thanks for your order.</p>

    {purchased.length > 0 && (
      <div class="border-border mt-8 rounded-2xl border p-6 text-left">
        <h2 class="mb-4 text-lg font-semibold">Your downloads</h2>
        <ul class="space-y-3">
          {purchased.filter(p => p.productId).map(p => (
            <li class="bg-surface-alt flex items-center justify-between rounded-xl px-4 py-3">
              <span>{p.name}</span>
              <a href={`/api/download?session_id=${session_id}&product=${p.productId}`} download class="bg-accent text-white rounded-lg px-4 py-2 text-sm font-semibold transition-all hover:opacity-80">Download</a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <a href="/" class="bg-accent text-white mt-8 inline-flex rounded-xl px-6 py-3 text-sm font-semibold transition-all hover:opacity-80">Continue shopping</a>
  </div>
</StoreLayout>

<script>
  localStorage.removeItem('cart')
</script>
